# name: test/sql/markdown_git_uri_names.test
# description: The markdown-file guard reads a name the way duck_tails' git:// grammar does (issue #107)
# group: [sql]

require markdown

require notwindows

# duck_tails 1.9.0 made `git://path?ref=rev` the canonical git URI. Everything
# before the first `?ref=` is the path, verbatim, so `#` and `@` there are part of
# the file name. The guard used to cut every name at the first `?` or `#` and then
# at the last `@`, so these URIs were rejected as "not a markdown file" even
# though duck_tails reads them (issue #107).
#
# The guard is a test on the name only, so local files whose names carry the same
# decoration exercise it without a git filesystem. The names hold `?`, which
# Windows forbids, so they are created here rather than committed.

statement ok
COPY (SELECT '# Hash In Name' AS line) TO '__TEST_DIR__/notes#1.md?ref=HEAD' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT '# At In Name' AS line) TO '__TEST_DIR__/icon@2x.md?ref=HEAD' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT '# Not Markdown' AS line) TO '__TEST_DIR__/image.png?ref=HEAD' (FORMAT csv, HEADER false, QUOTE '');

#===================================================================
# `#` before `?ref=` is part of the file name, not a fragment.
# read_markdown_sections is not used here: it reads `file.md#section-id`
# as a section filter, a documented feature this fix leaves alone.
#===================================================================

query I
SELECT trim(content, chr(10)) FROM read_markdown('__TEST_DIR__/notes#1.md?ref=HEAD');
----
# Hash In Name

#===================================================================
# `@` before `?ref=` is part of the file name, not a revision
#===================================================================

query I
SELECT title FROM read_markdown_sections('__TEST_DIR__/icon@2x.md?ref=HEAD') WHERE level = 1;
----
At In Name

# All three readers share the guard in MarkdownReader::GetFiles()
query I
SELECT count(*) FROM read_markdown('__TEST_DIR__/notes#1.md?ref=HEAD');
----
1

query I
SELECT count(*) > 0 FROM read_markdown_blocks('__TEST_DIR__/icon@2x.md?ref=HEAD');
----
true

#===================================================================
# The guard's intent is preserved: the ?ref= cut must not turn a
# non-markdown file into a markdown one
#===================================================================

statement error
SELECT * FROM read_markdown('__TEST_DIR__/image.png?ref=HEAD');
----
File is not a markdown file
