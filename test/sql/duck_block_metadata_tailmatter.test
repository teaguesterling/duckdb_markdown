# name: test/sql/duck_block_metadata_tailmatter.test
# description: metadata is tailmatter — after the body in duck_blocks, at the top in markdown
# group: [sql]

require markdown

# Ruled 2026-09-02: both metadata homes sit AFTER every body block, and there is
# no frontmatter position in duck_blocks. Markdown is the one output format with
# somewhere to put it, and that place is the top of the file — so the writer
# finds the block by TYPE and hoists it, never by where it sits in the list.
#
# Nothing asserted the position before this file. The reader emitted metadata
# first, the ruling moved it last, and the whole suite stayed green.

# READER: metadata comes after the body
query II
SELECT e.element_type, e.element_order
FROM (SELECT unnest(parse_markdown_to_duck_blocks(e'---\ntitle: T\n---\n\n# H\n\nBody.\n')) AS e)
WHERE e.kind = 'block' ORDER BY e.element_order;
----
heading	1
paragraph	2
metadata	3

# The reason for the end rather than the beginning: the body sequence is
# IDENTICAL whether or not the document has metadata, so a diff between the two
# reports metadata and nothing else instead of every body block as moved.
query I
SELECT (SELECT string_agg(e.element_order || ':' || e.element_type, ' ' ORDER BY e.element_order)
        FROM (SELECT unnest(parse_markdown_to_duck_blocks(e'# H\n\nBody.\n')) AS e) WHERE e.kind = 'block')
     = (SELECT string_agg(e.element_order || ':' || e.element_type, ' ' ORDER BY e.element_order)
        FROM (SELECT unnest(parse_markdown_to_duck_blocks(e'---\ntitle: T\n---\n\n# H\n\nBody.\n')) AS e)
        WHERE e.kind = 'block' AND e.element_type <> 'metadata');
----
true

# WRITER: metadata LAST still renders as frontmatter at the TOP.
# Rendering it in list order put the fence at the bottom of the file, where it is
# a thematic break rather than frontmatter -- the document re-parsed as
# heading, paragraph, HR, heading and the metadata was destroyed outright.
query I
SELECT duck_blocks_to_md([
  {kind: 'block', element_type: 'heading', content: 'Title', level: 1, encoding: 'text', attributes: MAP{'heading_level': '1'}, element_order: 0},
  {kind: 'block', element_type: 'paragraph', content: 'Body text.', level: 1, encoding: 'text', attributes: MAP{}::MAP(VARCHAR, VARCHAR), element_order: 1},
  {kind: 'block', element_type: 'metadata', content: 'title: T', level: 1, encoding: 'yaml', attributes: MAP{'role': 'frontmatter'}, element_order: 2}])
     = E'---\ntitle: T\n---\n\n# Title\n\nBody text.\n\n';
----
true

# REGRESSION: the destroyed form must never come back
query I
SELECT duck_blocks_to_md([
  {kind: 'block', element_type: 'heading', content: 'Title', level: 1, encoding: 'text', attributes: MAP{'heading_level': '1'}, element_order: 0},
  {kind: 'block', element_type: 'metadata', content: 'title: T', level: 1, encoding: 'yaml', attributes: MAP{'role': 'frontmatter'}, element_order: 1}])
     NOT LIKE '%Title%---%';
----
true

# A producer that still emits metadata FIRST renders identically — the writer
# reads the type, not the position, so both orders converge on one document
query I
SELECT duck_blocks_to_md([
  {kind: 'block', element_type: 'metadata', content: 'title: T', level: 1, encoding: 'yaml', attributes: MAP{'role': 'frontmatter'}, element_order: 0},
  {kind: 'block', element_type: 'heading', content: 'Title', level: 1, encoding: 'text', attributes: MAP{'heading_level': '1'}, element_order: 1}])
     = duck_blocks_to_md([
  {kind: 'block', element_type: 'heading', content: 'Title', level: 1, encoding: 'text', attributes: MAP{'heading_level': '1'}, element_order: 0},
  {kind: 'block', element_type: 'metadata', content: 'title: T', level: 1, encoding: 'yaml', attributes: MAP{'role': 'frontmatter'}, element_order: 1}]);
----
true

# The retired `frontmatter` type is hoisted too, so stored data keeps rendering
query I
SELECT duck_blocks_to_md([
  {kind: 'block', element_type: 'heading', content: 'Title', level: 1, encoding: 'text', attributes: MAP{'heading_level': '1'}, element_order: 0},
  {kind: 'block', element_type: 'frontmatter', content: 'title: T', level: 1, encoding: 'yaml', attributes: MAP{}::MAP(VARCHAR, VARCHAR), element_order: 1}])
     = E'---\ntitle: T\n---\n\n# Title\n\n';
----
true

# Both dialects round-trip with the new position
query II
SELECT duck_blocks_to_md(parse_markdown_to_duck_blocks(e'---\ntitle: T\n---\n\nBody.\n')) = E'---\ntitle: T\n---\n\nBody.\n\n',
       duck_blocks_to_md(parse_markdown_to_duck_blocks(e'+++\ntitle = "T"\n+++\n\nBody.\n')) = E'+++\ntitle = "T"\n+++\n\nBody.\n\n';
----
true	true
