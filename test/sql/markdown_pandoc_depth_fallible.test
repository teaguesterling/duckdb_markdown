# name: test/sql/markdown_pandoc_depth_fallible.test
# description: The duck_block -> Markdown converters' Pandoc depth cap stays an Invalid Input Error on DuckDB v2.0
# group: [sql]

require markdown

# =============================================================================
# duck_block_to_md, duck_blocks_to_md and duck_blocks_to_sections all reach
# ExtractPandocTextFromVal (src/duck_block_functions.cpp), which throws
# InvalidInputException past MAX_PANDOC_DEPTH. All three declare SetFallible().
#
# WHY THE CLASS PREFIX IS PINNED, and not just the message:
#
# On v1.5 the mark makes no difference to the error text. On v2.0 it does.
# ThrowNonFallibleFunctionError rewrites an unmarked scalar function's
# execution-error throw into an INTERNAL Error that QUOTES the original message:
#
#   INTERNAL Error: Scalar function "x" threw an execution error, but the
#   function is not marked as fallible ... Error: <the original message>
#
# So an expectation matching only "Pandoc inline nesting exceeds ..." matches the
# rewritten form too, and passes whether or not the function is marked. It cannot
# detect a lost SetFallible(). Only the "Invalid Input Error: " prefix does.
# Measured on duck_block_utils' throwaway run 34860157025 (2026-09-14): with the
# mark removed, the 2.0 leg produced the INTERNAL form and the class-prefixed
# expectation rejected it. Same technique as
# test/sql/markdown_table_extraction_fallible.test, which covers the other
# reachable guard (the inline depth cap, via the table extractors).
#
# The technique has a limit worth recording: ThrowNonFallibleFunctionError is
# gated on Exception::IsExecutionError, which is true only for InvalidInput,
# OutOfRange and Conversion. An IOException or BinderException is never
# rewritten, so no expectation can guard an IO- or bind-throwing function's
# declaration, however it is written.
#
# HOW THE GUARD IS REACHED (both facts are load-bearing for these inputs):
#
#  1. The Pandoc walker is entered from the BLOCK renderer only, and only when
#     encoding='json' -- blockquote (ExtractPandocBlocksText), list
#     (ParsePandocListItems) and table (ParsePandocTable). A paragraph with
#     encoding='json' does NOT route there: it emits its content verbatim.
#     These cases use blockquote.
#  2. EVERY recursion counts toward depth, ARRAYS INCLUDED. One level of nested
#     emphasis therefore costs 2: the {"t":"Emph","c":[...]} object, and the
#     array inside its "c". Measured against this build: 100 nested Emph render
#     and 101 throw; 201 bare array levels are accepted and 202 throw.
#
# THE ARRAY ARM USED TO NOT COUNT, and that was a bug, not a quirk to write
# tests around. An earlier version of this file described the old behaviour in
# this very comment and then carefully nested in objects to avoid it. But an
# uncounted arm means no value of MAX_PANDOC_DEPTH can bound array recursion:
# 100000 nested arrays segfaulted DuckDB on an 8 MB stack while the same depth
# in objects threw cleanly. The array cases below are the regression test.
#
# WHY THE CAP IS 200 AND NOT 1000: at 1000 the guard was unreachable on a macOS
# worker thread, which gets 512 KB. The walker costs ~275 bytes per frame, so
# the stack died around depth 900 -- a SIGBUS mid-suite, not an error. This is
# not hypothetical: it crashed the registry's macOS arm64 build of v1.9.3, and
# because a failed build skips the deploy job, it silently prevented that
# release from ever publishing. Anything asserted in this file must stay far
# enough inside the cap that the test cannot itself become the crash it exists
# to prevent.
# =============================================================================

# ---- Controls: shallow nesting renders on every surface, so the expectations
# ---- below pin an input-dependent throw rather than a function that always fails.

query I
SELECT duck_blocks_to_md([{kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 3) || '{"t":"Str","c":"x"}' || repeat(']}', 3) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]) LIKE '> ***x***%';
----
true

query I
SELECT duck_block_to_md({kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 3) || '{"t":"Str","c":"x"}' || repeat(']}', 3) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}) LIKE '> ***x***%';
----
true

query I
SELECT len(duck_blocks_to_sections([{kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 3) || '{"t":"Str","c":"x"}' || repeat(']}', 3) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]));
----
1

# ---- Boundary: 100 nested Emph is the deepest that renders (depth 200).
# ----
# ---- These check rendered CONTENT, not IS NOT NULL. '' IS NOT NULL is true, so
# ---- an IS NOT NULL form would keep passing if the guard ever began silently
# ---- returning an empty string instead of rendering -- a green that measures
# ---- nothing, which is the same defect this file exists to prevent on the error
# ---- side. Measured at 100 Emph: exactly 205 chars, opening '> ' then asterisks.

query I
SELECT len(duck_blocks_to_md([{kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 100) || '{"t":"Str","c":"x"}' || repeat(']}', 100) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]));
----
205

query I
SELECT duck_block_to_md({kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 100) || '{"t":"Str","c":"x"}' || repeat(']}', 100) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}) LIKE '> ***%';
----
true

query I
SELECT len(duck_blocks_to_sections([{kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 100) || '{"t":"Str","c":"x"}' || repeat(']}', 100) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]));
----
1

# ---- 101 nested Emph (depth 202): the cap fires, and it must surface as
# ---- Invalid Input on every line, on all three marked surfaces.

statement error
SELECT duck_blocks_to_md([{kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 101) || '{"t":"Str","c":"x"}' || repeat(']}', 101) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]);
----
Invalid Input Error: Pandoc inline nesting exceeds maximum supported depth (200)

statement error
SELECT duck_block_to_md({kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 101) || '{"t":"Str","c":"x"}' || repeat(']}', 101) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0});
----
Invalid Input Error: Pandoc inline nesting exceeds maximum supported depth (200)

statement error
SELECT duck_blocks_to_sections([{kind: 'block', element_type: 'blockquote', content: '[' || repeat('{"t":"Emph","c":[', 101) || '{"t":"Str","c":"x"}' || repeat(']}', 101) || ']', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]);
----
Invalid Input Error: Pandoc inline nesting exceeds maximum supported depth (200)

# ---- REGRESSION: nesting built from ARRAYS alone, which the guard once did not
# ---- count at all. Before the fix these did not throw -- they either returned a
# ---- value (at depths the stack happened to survive) or killed the process.
# ---- The control first: 100 array levels are inside the cap and still render.

query I
SELECT duck_blocks_to_md([{kind: 'block', element_type: 'blockquote', content: repeat('[', 100) || '{"t":"Str","c":"x"}' || repeat(']', 100), level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]) LIKE '> x%';
----
true

query I
SELECT len(duck_blocks_to_sections([{kind: 'block', element_type: 'blockquote', content: repeat('[', 100) || '{"t":"Str","c":"x"}' || repeat(']', 100), level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]));
----
1

# ---- 5000 array levels: far past the cap, so the guard must fire early and the
# ---- error must carry the class prefix on all three surfaces. 5000 is chosen to
# ---- be well beyond the boundary while the throw happens at depth 201, so only
# ---- ~200 frames are ever on the stack -- this case cannot itself overflow.

statement error
SELECT duck_blocks_to_md([{kind: 'block', element_type: 'blockquote', content: repeat('[', 5000) || '{"t":"Str","c":"x"}' || repeat(']', 5000), level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]);
----
Invalid Input Error: Pandoc inline nesting exceeds maximum supported depth (200)

statement error
SELECT duck_block_to_md({kind: 'block', element_type: 'blockquote', content: repeat('[', 5000) || '{"t":"Str","c":"x"}' || repeat(']', 5000), level: 1, encoding: 'json', attributes: MAP{}, element_order: 0});
----
Invalid Input Error: Pandoc inline nesting exceeds maximum supported depth (200)

statement error
SELECT duck_blocks_to_sections([{kind: 'block', element_type: 'blockquote', content: repeat('[', 5000) || '{"t":"Str","c":"x"}' || repeat(']', 5000), level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]);
----
Invalid Input Error: Pandoc inline nesting exceeds maximum supported depth (200)

# ---- A paragraph with encoding='json' does not route into the Pandoc walker at
# ---- all, so the same content that throws above is emitted verbatim here. This
# ---- pins the gate: if paragraph ever started routing, the cases above would
# ---- stop being about blockquote.

query I
SELECT duck_blocks_to_md([{kind: 'block', element_type: 'paragraph', content: '[{"t":"Str","c":"hello"}]', level: 1, encoding: 'json', attributes: MAP{}, element_order: 0}]) LIKE '[{"t":"Str","c":"hello"}]%';
----
true
