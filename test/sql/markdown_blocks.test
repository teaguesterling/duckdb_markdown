# name: test/sql/markdown_blocks.test
# description: Test read_markdown_blocks functionality with duck_block shape
# group: [sql]

require markdown

# =============================================================================
# Test: duck_block shape returned by read_markdown_blocks
# =============================================================================

# Verify the new column structure (kind, element_type, element_order)
query III
SELECT kind, element_type, element_order FROM read_markdown_blocks('test/data/blocks_basic.md') LIMIT 1;
----
block	heading	0

# =============================================================================
# Test: Basic read_markdown_blocks from file (flattened output)
# =============================================================================

query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_basic.md');
----
5

# =============================================================================
# Test: Block types are correctly identified
# =============================================================================

query II
SELECT element_type, level FROM read_markdown_blocks('test/data/blocks_basic.md') ORDER BY element_order;
----
heading	1
paragraph	1
code	1
blockquote	1
paragraph	2

# =============================================================================
# Test: Heading content extraction
# =============================================================================

query II
SELECT element_type, content FROM read_markdown_blocks('test/data/blocks_basic.md') WHERE element_type = 'heading';
----
heading	Hello

# =============================================================================
# Test: Code block with language
# =============================================================================

query II
SELECT content, attributes['language'] FROM read_markdown_blocks('test/data/blocks_basic.md') WHERE element_type = 'code';
----
print("hello")	python

# =============================================================================
# Test: Frontmatter extraction
# =============================================================================

# Spec 6.2: the type is `metadata` and the ROLE says which construct it came
# from. `frontmatter` was never a declared element_type. Level is 1 = NOT NESTED,
# ruled upstream at 2771e9e; read_markdown_sections keeps its own 0-6 heading
# rank on its own column, which is a different measurement.
query IIII
SELECT element_type, level, encoding, attributes['role']
FROM read_markdown_blocks('test/data/blocks_frontmatter.md') WHERE element_type = 'metadata';
----
metadata	1	yaml	frontmatter

# The old name must NOT come back
query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_frontmatter.md') WHERE element_type = 'frontmatter';
----
0

query I
SELECT content LIKE '%title: Test Doc%' FROM read_markdown_blocks('test/data/blocks_frontmatter.md') WHERE element_type = 'metadata';
----
true

# =============================================================================
# Test: List extraction (STRUCTURAL)
# =============================================================================

# Items are list_item children, not a JSON array in the list's content. The old
# shape flattened each item with GetInlineText and skipped nested lists outright,
# so `**bold**` came back as bold and a sublist's items vanished.
query II
SELECT element_type, encoding FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'list';
----
list	text

# A TIGHT list: cmark renders this as <ul><li>Item 1</li>... with no <p>, so
# each item's run is a Plain and 6.0's content rule folds it onto the item (#60).
# There is no paragraph level at all. This file previously expected
# list -> list_item -> paragraph for every item, which was the collapse: the
# reader labelled every run `paragraph` and a tight list was indistinguishable
# from a loose one. The loose form still descends three levels -- see
# duck_block_tight_loose.test.
query III
SELECT element_type, level, content FROM read_markdown_blocks('test/data/blocks_list.md') ORDER BY element_order;
----
list	1	NULL
list_item	2	Item 1
list_item	2	Item 2
list_item	2	Item 3

query I
SELECT attributes['ordered'] FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'list';
----
false

# =============================================================================
# Test: Ordered list
# =============================================================================

query I
SELECT attributes['ordered'] FROM read_markdown_blocks('test/data/blocks_ordered_list.md') WHERE element_type = 'list';
----
true

# =============================================================================
# Test: Horizontal rule
# =============================================================================

query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_hr.md') WHERE element_type = 'hr';
----
1

# =============================================================================
# Test: Table extraction (JSON encoded)
# =============================================================================

query II
SELECT element_type, encoding FROM read_markdown_blocks('test/data/blocks_table.md') WHERE element_type = 'table';
----
table	json

query I
SELECT content LIKE '%"headers"%' FROM read_markdown_blocks('test/data/blocks_table.md') WHERE element_type = 'table';
----
true

# Verify headers contain the correct values (Name, Age)
query I
SELECT content LIKE '%"Name"%' AND content LIKE '%"Age"%' FROM read_markdown_blocks('test/data/blocks_table.md') WHERE element_type = 'table';
----
true

# Verify data rows contain the correct values
query I
SELECT content LIKE '%"Alice"%' AND content LIKE '%"Bob"%' FROM read_markdown_blocks('test/data/blocks_table.md') WHERE element_type = 'table';
----
true

# =============================================================================
# Test: Block order is sequential
# =============================================================================

query I
SELECT string_agg(element_order::VARCHAR, ',' ORDER BY element_order) FROM read_markdown_blocks('test/data/blocks_basic.md');
----
0,1,2,3,4

# =============================================================================
# Test: include_filepath option
# =============================================================================

query I
SELECT filename LIKE '%blocks_basic.md' FROM read_markdown_blocks('test/data/blocks_basic.md', include_filepath := true) LIMIT 1;
----
true

# Provenance is TRAILING, and that is load-bearing rather than cosmetic.
# duck_block spec 6.4 keys acceptance on the exact 8-field struct with
# `filename` LAST. Consumers read struct children BY INDEX, so a leading field
# puts the file path at index 0 where every consumer expects `kind` -- shifting
# every canonical field by one. Asserted as an exact type string so a
# reordering fails here rather than downstream.
query I
SELECT typeof(list(b)) = 'STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER, filename VARCHAR)[]'
FROM read_markdown_blocks('test/data/blocks_basic.md', filename := true) b;
----
true

# The deprecated alias produces the identical shape -- the parameter name never
# reaches the data, only the column name and position do.
query I
SELECT typeof(list(b)) = 'STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER, filename VARCHAR)[]'
FROM read_markdown_blocks('test/data/blocks_basic.md', include_filepath := true) b;
----
true

# Without provenance the shape is the canonical 7-field duck_block.
query I
SELECT typeof(list(b)) = 'STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER)[]'
FROM read_markdown_blocks('test/data/blocks_basic.md') b;
----
true

# =============================================================================
# Test: All columns present
# =============================================================================

query IIIIIII
SELECT kind, element_type, content IS NOT NULL, level, encoding, attributes IS NOT NULL, element_order FROM read_markdown_blocks('test/data/blocks_basic.md') WHERE element_type = 'heading';
----
block	heading	true	1	text	true	0

# =============================================================================
# Test: Complex document with multiple block types
# =============================================================================

# 11 until lists became structural: a list was one block with its items packed
# into a JSON string. 18 once each item became list_item + paragraph.
#
# 17 since #60, and the two changes pull in opposite directions. Derived from
# cmark's own HTML for this file rather than read off the binary:
#
#   <blockquote><p>...</p></blockquote>   +1  the paragraph is no longer folded
#                                             away into the blockquote
#   <li>Item 1 <ul>...</ul></li>          =   list_item > plain + list, where it
#                                             was list_item > paragraph + list
#   <li>Nested item</li>, <li>Item 2</li> -2  tight items with a single text
#                                             child fold onto the item
#
# Expected sequence, which the binary reproduces exactly:
#   heading paragraph heading blockquote paragraph heading
#   list list_item plain list list_item list_item
#   code code table hr paragraph
query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_nested.md') WHERE kind = 'block';
----
17

# Verify all expected block types are present
query I
SELECT count(DISTINCT element_type) FROM read_markdown_blocks('test/data/blocks_nested.md') WHERE kind = 'block';
----
9

# Rich text is emitted as structured kind='inline' children (not markdown syntax
# inside content); the blockquote decomposes into inline rows.
#
# Level 3, not 2, since #60: this file's only inline run is the blockquote's, and
# the blockquote's paragraph used to be folded away -- putting its inlines
# directly under the blockquote at 2. With the paragraph restored the chain is
# blockquote(1) > paragraph(2) > inlines(3).
query II
SELECT count(*) > 0, bool_and(level = 3)
FROM read_markdown_blocks('test/data/blocks_nested.md')
WHERE kind = 'inline';
----
true	true

# Check heading levels (heading_level attribute, all have level=1 as document-level blocks)
query III
SELECT content, level, attributes['heading_level'] as heading_level FROM read_markdown_blocks('test/data/blocks_nested.md') WHERE element_type = 'heading' ORDER BY element_order;
----
Main Heading	1	1
Subheading	1	2
Deep Heading	1	3

# =============================================================================
# Test: Code blocks with and without language
# =============================================================================

query II
SELECT attributes['language'], content LIKE '%SELECT%' FROM read_markdown_blocks('test/data/blocks_nested.md') WHERE element_type = 'code' ORDER BY element_order;
----
sql	true
NULL	false

# =============================================================================
# Test: Special characters in content
# =============================================================================

# Heading with inline formatting should extract text
query I
SELECT content FROM read_markdown_blocks('test/data/blocks_special.md') WHERE element_type = 'heading';
----
Heading with bold and italic

# Paragraph with inline code and a link decomposes into structured inline
# children; the code span carries its literal text (no backticks in content)
query I
SELECT bool_or(element_type = 'code' AND content = 'inline code')
FROM read_markdown_blocks('test/data/blocks_special.md') WHERE kind = 'inline';
----
true

# =============================================================================
# Test: Multiple files via glob
# =============================================================================

# 50 since #60, and the two directions both show up in the per-file counts:
#
#   blocks_basic          4 -> 5    the blockquote's paragraph is no longer folded
#   blocks_list           7 -> 4    three tight items fold their run onto the item
#   blocks_ordered_list   7 -> 4    same
#   blocks_unicode        9 -> 7    same, two items
#   blocks_nested        18 -> 17   one of each, and a `plain` where the outer
#                                   tight item holds both a run and a sublist
#   frontmatter 3, hr 3, special 6, table 1 -- unchanged, no lists
#
# Every one of those is what cmark says the file is: <li>x</li> is tight and
# folds, <li><p>x</p></li> is loose and does not, and <blockquote><p>x</p></…>
# has a paragraph in it.
query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_*.md') WHERE kind = 'block';
----
50

query I
SELECT count(DISTINCT filename) FROM read_markdown_blocks('test/data/blocks_*.md', include_filepath := true);
----
9

# =============================================================================
# Test: Empty file handling
# =============================================================================

statement ok
COPY (SELECT '') TO '__TEST_DIR__/empty.md' (FORMAT CSV, HEADER false, QUOTE '');

query I
SELECT count(*) FROM read_markdown_blocks('__TEST_DIR__/empty.md');
----
0

# =============================================================================
# Test: Only frontmatter
# =============================================================================

statement ok
COPY (SELECT E'---\ntitle: Only FM\n---\n') TO '__TEST_DIR__/only_fm.md' (FORMAT CSV, HEADER false, QUOTE '');

query II
SELECT element_type, level FROM read_markdown_blocks('__TEST_DIR__/only_fm.md');
----
metadata	1

# =============================================================================
# Test: Attributes are correctly populated
# =============================================================================

# Headings should have id attribute
query I
SELECT attributes['id'] IS NOT NULL FROM read_markdown_blocks('test/data/blocks_basic.md') WHERE element_type = 'heading';
----
true

# Lists should have ordered attribute
query I
SELECT attributes['ordered'] IN ('true', 'false') FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'list';
----
true

# =============================================================================
# Test: Blockquote content is properly extracted
# =============================================================================

# The CARRIER changed with #60. cmark's answer for `> A quote` is
# <blockquote><p>A quote</p></blockquote> -- there is a paragraph, and this
# reader used to delete it, folding the text onto the blockquote itself. That
# made BlockQuote[Para[Str]] indistinguishable from BlockQuote[Plain[Str]].
# The blockquote now carries no content of its own and the text is in its child,
# which is what "properly extracted" has to mean if the shape is to survive.
query II
SELECT b.element_type, b.content
FROM unnest(parse_markdown_to_duck_blocks((SELECT content FROM read_text('test/data/blocks_basic.md')))) AS t(b)
WHERE b.element_type IN ('blockquote', 'paragraph') AND b.level >= 1 AND b.element_order >= 3
ORDER BY b.element_order;
----
blockquote	NULL
paragraph	A quote

# =============================================================================
# Test: a list carries NO content -- its items are children
# =============================================================================

# The inverse of what this used to assert. `content LIKE '["%'` pinned the JSON
# array that flattened each item and discarded nested lists; a list that carries
# content at all is now the pre-structural shape, and upstream's advisory rules
# object to it by name (list_not_structural).
query I
SELECT coalesce(content, '') = '' FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'list';
----
true

# ...and the items are where the text went
query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'list_item';
----
3

# ...and each item's text is on the ITEM, not in the list and not in a paragraph
# beneath it. cmark renders this file as <ul><li>Item 1</li>... -- tight, no <p> --
# so each run is a Plain and 6.0's content rule folds it onto its item (#60).
# There are no paragraphs in this document at all, which is the assertion below.
query I
SELECT string_agg(content, '|' ORDER BY element_order) FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'list_item';
----
Item 1|Item 2|Item 3

query I
SELECT count(*) FROM read_markdown_blocks('test/data/blocks_list.md') WHERE element_type = 'paragraph';
----
0

# =============================================================================
# Test: Unicode and international characters
# =============================================================================

query I
SELECT content FROM read_markdown_blocks('test/data/blocks_unicode.md') WHERE element_type = 'heading';
----
Unicode Test 日本語

# bool_or, not a bare LIKE: list items are paragraphs now, so this document has
# four of them rather than one.
query I
SELECT bool_or(content LIKE '%émojis%') FROM read_markdown_blocks('test/data/blocks_unicode.md') WHERE element_type = 'paragraph';
----
true

# The list's non-ASCII text lives in its items, not in the list's own content --
# and since #60 it is ON the item rather than in a paragraph beneath it, because
# cmark renders this list as <li>中文</li>... with no <p>. The property being
# pinned is that multi-byte text survives the carrier, and it does.
query I
SELECT string_agg(content, '|' ORDER BY element_order) FROM read_markdown_blocks('test/data/blocks_unicode.md') b
WHERE b.element_type = 'list_item';
----
中文|العربية|עברית

# =============================================================================
# Test: Double round-trip stability
# =============================================================================

statement ok
COPY (SELECT kind, element_type, content, level, encoding, attributes FROM read_markdown_blocks('test/data/blocks_basic.md'))
TO '__TEST_DIR__/roundtrip1.md' (FORMAT MARKDOWN, markdown_mode 'blocks');

statement ok
COPY (SELECT kind, element_type, content, level, encoding, attributes FROM read_markdown_blocks('__TEST_DIR__/roundtrip1.md'))
TO '__TEST_DIR__/roundtrip2.md' (FORMAT MARKDOWN, markdown_mode 'blocks');

# Both round-trips should have same block count
query I
SELECT (SELECT count(*) FROM read_markdown_blocks('__TEST_DIR__/roundtrip1.md')) =
       (SELECT count(*) FROM read_markdown_blocks('__TEST_DIR__/roundtrip2.md'));
----
true
